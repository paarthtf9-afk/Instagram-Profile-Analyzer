SECRET_KEY=your-secret-key-here
PORT=5000

# Instagram Session Cookies (optional but recommended)
# Get these from your browser after logging into Instagram:
# 1. Open instagram.com in Chrome
# 2. Press F12 → Application → Cookies → instagram.com
# 3. Copy these values:
IG_SESSIONID=your-session-id-here
IG_CSRFTOKEN=your-csrf-token-here
IG_DS_USER_ID=your-user-id-here
